# DeepSeek API 密钥（从 https://platform.deepseek.com 获取）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# mxnzp 汉字 API（从微信小程序“电点科技”获取）
MXNZP_APP_ID=your_app_id_here
MXNZP_APP_SECRET=your_app_secret_here

# CORS 允许的前端域名，逗号分隔
CORS_ORIGINS=http://localhost:5173,https://你的vercel域名.vercel.app

# SQLite 数据库路径（部署时指向持久卷）
DATABASE_PATH=./riddles.db

# 管理后台密码
ADMIN_PASSWORD=your_admin_password_here
